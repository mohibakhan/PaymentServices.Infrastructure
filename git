async Task RunTests(IServiceProvider services)

{

    using var scope = services.CreateScope();

    var limitsClient = scope.ServiceProvider.GetRequiredService<ILimitsInternalClient>();

    var keywordService = scope.ServiceProvider.GetRequiredService<IKeywordScreenService>();


    // Test Keyword ScreeningConsole.WriteLine("\n[TEST] Keyword Screening Service");

    try 

    {

        Console.WriteLine("-> Loading keywords...");

        await keywordService.ReloadKeywordsAsync();


        var safeText = "This is a normal payment request.";

        var result = keywordService.ScreenText(safeText);

        Console.WriteLine($"-> Text: '{safeText}' | Result: {(result.IsPositive ? "MATCH FOUND" : "Clear")}");

    }

    catch (Exception ex)

    {

        Console.WriteLine($"!! Keyword Screening Error: {ex.Message}");

    }


    // Test Category Limits EvaluationConsole.WriteLine("\n[TEST] Limits Internal Client (Category Check)");

    try 

    {

        var categoryRequest = new EvaluateCategoryRequest 

        (

            PartitionKey: "9990000001",

            Category: "Send",

            Amount: 500.00m,

            UpdateUsage: false  // set true to increase the usage so far for aggregate daily/weekly,monthgly, etc). does nothing for item limit        );


        Console.WriteLine($"-> Evaluating all limits in category '{categoryRequest.Category}' for {categoryRequest.Amount}...");

        var response = await limitsClient.EvaluateCategoryLimitsAsync(categoryRequest);


        if (response.Approved)

        {

            Console.WriteLine("-> Approval Status: APPROVED (All category limits passed)");

        }

        else        {

            Console.WriteLine($"-> Approval Status: DENIED | Failed Limit: {response.FailedLimit?.LimitType} | Message: {response.Message}");

        }

    }

    catch (Exception ex)

    {

        Console.WriteLine($"!! Category Limits Evaluation Error: {ex.Message}");

    }


    Console.WriteLine("\n================================================");

    Console.WriteLine("   All tests completed.");

    Console.WriteLine("================================================");

}

    // Test Limits EvaluationConsole.WriteLine("\n[TEST] Limits Internal Client");

    try 

    {

        var request = new EvaluateLimitRequest 

        (

            PartitionKey: "CORE_BANKING",

            Id: "MAX_TXN_AMOUNT",

            Amount: 500.00m,

            UpdateUsage: false        );


        Console.WriteLine($"-> Evaluating limit for {request.Amount} in {request.PartitionKey}...");

        var response = await limitsClient.EvaluateLimitAsync(request);

        Console.WriteLine($"-> Approval Status: {(response.Approved ? "APPROVED" : "DENIED")}");

    }

    catch (Exception ex)

    {

        Console.WriteLine($"!! Limits Evaluation Error: {ex.Message}");

    }


    Console.WriteLine("\n================================================");

    Console.WriteLine("   All tests completed.");

    Console.WriteLine("================================================");

}
